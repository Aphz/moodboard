{
  "name": "moodboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Moodboard: tablero de referencias tipo PureRef para iPhone e iPad (PWA + Capacitor)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
